   "source": [
    "# sum은 내장 함수 이름이라 가리는 습관은 피해야 한다.\n",
    "def sum_numbers(numbers: list[int]) -> int:\n",
    "    result = 0\n",
    "    while numbers:\n",
    "        number = numbers.pop()\n",
    "        result += number\n",
    "    return result\n",
    "\n",
    "\n",
    "# 함수 호출\n",
    "# sum([1, 2, 3, 4, 5])\n",
    "result = sum([1, 2, 3, 4, 5])\n",
    "print(result)"
   ]
