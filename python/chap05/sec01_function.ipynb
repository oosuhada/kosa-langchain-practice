   "source": [
    "# 함수 정의\n",
    "def print_repeat(char: str, count: int) -> None:  # definition 정의하겠다 라는 의미\n",
    "    while count:\n",
    "        print(char, end=\"\")\n",
    "        count -= 1\n",
    "\n",
    "\n",
    "# 함수 호출\n",
    "print_repeat(\"*\", 10)"
   ]
